{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NaukriSearchConfig": {
    "Keywords": [
      ".NET Developer",
      "ASP.NET Core",
      "C#",
      "Backend Developer",
      "Software Engineer"
    ],
    "Locations": [
      "Kerala",
      "Bangalore",
      "Remote"
    ],
    "MinimumExperience": 0,
    "MaximumExperience": 5,
    "MinimumSalaryInr": 300000,
    "MaximumSalaryInr": 1500000,
    "ExpectedCtcLpa": 12.0,
    "PostedWithinDays": 7,
    "PreferredCurrency": "INR"
  },
  "AutomationConfig": {
    "MaxJobsToProcess": 5,
    "DelayBetweenActionsSeconds": 8,
    "RandomizeDelay": true,
    "Headless": false,
    "PreferredBrowser": "Chromium",
    "RetryFailedOperations": true,
    "MaxRetryCount": 3
  }
}
